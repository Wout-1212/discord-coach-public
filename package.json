{
  "name": "discord-coach",
  "version": "1.0.0",
  "private": true,
  "description": "Discord /coach command that forwards questions to a Claude scheduled task (Intervals.icu training coach).",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "register": "node --env-file=.dev.vars scripts/register-commands.mjs",
    "webhook": "node --env-file=.dev.vars scripts/create-webhook.mjs",
    "setup-script": "node scripts/build-setup-script.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=22.6"
  }
}
